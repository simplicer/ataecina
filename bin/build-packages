#!/usr/bin/env bash
# Builds the .deb, .rpm and Arch packages of each architecture into dist/
# with nfpm (ADR 0008), and the release archive ataecina-VERSION-linux-ARCH.tar.gz
# (the built command and widget plus ./install, for any distribution
# and no root). Called by `make package`, which has already built
# var/build/package/<arch>/ataecina and the widget, and exports NFPM (the
# pinned nfpm command) and SOURCE_DATE_EPOCH (the last commit's time, so
# that the same commit always gives the same packages).
#
# Usage: bin/build-packages ARCH...      (Go architecture names: amd64 arm64)
# PACKAGE_FORMATS chooses the formats (default "deb rpm archlinux tar").
set -euo pipefail
cd "$(dirname "$0")/.."

: "${NFPM:?NFPM must name the pinned nfpm command (make package sets it)}"
: "${SOURCE_DATE_EPOCH:?SOURCE_DATE_EPOCH must be set (make package sets it)}"
[ $# -gt 0 ] || { echo "usage: bin/build-packages ARCH..." >&2; exit 2; }
export SOURCE_DATE_EPOCH

repository=$PWD
mkdir -p dist
rm -f dist/ataecina[-_]* dist/SHA256SUMS

# archive ARCH writes dist/ataecina-VERSION-linux-ARCH.tar.gz: the command,
# the built widget and what bin/install-files reads, with ./install on
# top; owners, order and times pinned so the same commit gives the same
# bytes.
archive() {
	local arch=$1 name stage
	name=ataecina-$(tr -d '[:space:]' <VERSION)-linux-$arch
	stage=var/build/package/$arch/archive/$name
	rm -rf "var/build/package/$arch/archive"
	mkdir -p "$stage/bin" "$stage/infra/systemd" "$stage/share/icons/hicolor/scalable/apps" \
		"$stage/share/applications" "$stage/etc" "$stage/widget"
	install -m 0755 "var/build/package/$arch/ataecina" "$stage/ataecina"
	install -m 0755 infra/packaging/tarball/install "$stage/install"
	install -m 0755 bin/install-files "$stage/bin/install-files"
	install -m 0644 infra/systemd/ataecina-collect.service.in infra/systemd/ataecina-collect.timer "$stage/infra/systemd/"
	install -m 0644 share/icons/hicolor/scalable/apps/ataecina.svg "$stage/share/icons/hicolor/scalable/apps/"
	install -m 0644 share/applications/org.simplicer.ataecina.desktop "$stage/share/applications/"
	install -m 0644 etc/ataecina.example.json "$stage/etc/"
	install -m 0644 README.md CHANGELOG.md LICENSE "$stage/"
	cp -r var/build/plasmoid/org.simplicer.ataecina "$stage/widget/"
	find "$stage/widget" -type d -exec chmod 0755 {} +
	find "$stage/widget" -type f -exec chmod 0644 {} +
	tar --sort=name --owner=0 --group=0 --numeric-owner --mtime="@$SOURCE_DATE_EPOCH" \
		-C "var/build/package/$arch/archive" -cf - "$name" | gzip -9n >"dist/$name.tar.gz"
}
for arch in "$@"; do
	work=var/build/package/$arch
	if [ -d "$work/root" ]; then
		rm -r "$work/root"
	fi
	bin/install-files --prefix /usr --destdir "$work/root" --binary "$work/ataecina" >/dev/null
	# nfpm keeps the files' own mtimes inside a tree; pin them to the commit.
	find "$work/root" -exec touch -h -d "@$SOURCE_DATE_EPOCH" {} +
	for packager in ${PACKAGE_FORMATS:-deb rpm archlinux tar}; do
		if [ "$packager" = tar ]; then
			archive "$arch"
			continue
		fi
		version=$(bin/package-version "${packager%linux}")
		(cd "$work/root" && ATAECINA_ARCH=$arch ATAECINA_VERSION=$version \
			$NFPM package --config "$repository/infra/packaging/nfpm.yaml" --packager "$packager" \
			--target "$repository/dist/")
	done
done

(cd dist && sha256sum ataecina[-_]* >SHA256SUMS)
echo "build-packages: $(grep -c . dist/SHA256SUMS) packages of $(tr -d '[:space:]' <VERSION) in dist/ (SHA256SUMS written)"
