#!/usr/bin/env bash
# Verifies the packages bin/build-packages wrote into dist/: each one holds
# exactly the files bin/install-files staged for its architecture, with the
# binary executable, the unit pointing at /usr/bin, and the version mapped
# for its format. Debian packages are read with dpkg-deb, Arch packages with
# tar; RPMs are read with rpm when it is installed and otherwise only
# checked against SHA256SUMS.
#
# Usage: bin/check-packages ARCH...
set -euo pipefail
cd "$(dirname "$0")/.."

fail() {
	echo "check-packages: $*" >&2
	exit 1
}
[ $# -gt 0 ] || fail "usage: bin/check-packages ARCH..."

version=$(tr -d '[:space:]' <VERSION)
debian=$(bin/package-version deb)
arch_version=$(bin/package-version arch)

(cd dist && sha256sum --quiet --check SHA256SUMS) || fail "dist/SHA256SUMS does not match the packages"

listing=$(mktemp -d)
trap 'rm -r "$listing"' EXIT

for arch in "$@"; do
	case $arch in
	amd64) rpm_arch=x86_64 pacman_arch=x86_64 ;;
	arm64) rpm_arch=aarch64 pacman_arch=aarch64 ;;
	*) fail "unknown architecture $arch" ;;
	esac
	root=var/build/package/$arch/root
	(cd "$root" && find . -type f | sed 's|^\./|/|' | sort) >"$listing/staged"
	grep -qx /usr/bin/ataecina "$listing/staged" || fail "nothing staged for $arch"

	deb=dist/ataecina_${debian}-1_${arch}.deb
	[ -f "$deb" ] || fail "$deb is missing"
	[ "$(dpkg-deb --field "$deb" Version)" = "${debian}-1" ] || fail "$deb has version $(dpkg-deb --field "$deb" Version)"
	dpkg-deb --fsys-tarfile "$deb" | tar -t | grep -v '/$' | sed 's|^\./|/|' | sort >"$listing/deb"
	diff -u "$listing/staged" "$listing/deb" || fail "$deb does not hold the staged files"
	dpkg-deb --fsys-tarfile "$deb" | tar -tv ./usr/bin/ataecina | grep -q '^-rwxr-xr-x root/root' ||
		fail "$deb: /usr/bin/ataecina is not 0755 root:root"
	dpkg-deb --fsys-tarfile "$deb" | tar -xO ./usr/lib/systemd/user/ataecina-collect.service |
		grep -qx 'ExecStart=/usr/bin/ataecina collect' || fail "$deb: the unit does not run /usr/bin/ataecina"

	pkg=dist/ataecina-${arch_version}-1-${pacman_arch}.pkg.tar.zst
	[ -f "$pkg" ] || fail "$pkg is missing"
	tar --zstd -xOf "$pkg" .PKGINFO | grep -qx "pkgver = ${arch_version}-1" || fail "$pkg has the wrong pkgver"
	tar --zstd -tf "$pkg" | grep -v '/$' | grep -v '^\.' | sed 's|^|/|' | sort >"$listing/arch"
	diff -u "$listing/staged" "$listing/arch" || fail "$pkg does not hold the staged files"

	rpm=dist/ataecina-${debian}-1.${rpm_arch}.rpm
	[ -f "$rpm" ] || fail "$rpm is missing"
	if command -v rpm >/dev/null; then
		[ "$(rpm -qp --queryformat '%{VERSION}' "$rpm")" = "$debian" ] || fail "$rpm has the wrong version"
		rpm -qlp "$rpm" | sort >"$listing/rpm"
		grep -Fxf "$listing/staged" "$listing/rpm" | diff -u "$listing/staged" - || fail "$rpm does not hold the staged files"
	else
		echo "check-packages: rpm not installed; $rpm only checked against SHA256SUMS"
	fi
done
echo "check-packages: $(grep -c . dist/SHA256SUMS) packages of $version verified"
