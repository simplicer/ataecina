# Ataecina collector: reads every configured subscription once and keeps
# the snapshot (ADR 0005). Started every few minutes by
# ataecina-collect.timer, or on demand ("refresh now").
# @BINDIR@ is replaced at install time (/usr/bin or ~/.local/bin).

[Unit]
Description=Ataecina: read every AI subscription allowance once
Documentation=https://codeberg.org/simplicer/ataecina

[Service]
Type=oneshot
ExecStart=@BINDIR@/ataecina collect
TimeoutStartSec=60
Nice=10
IOSchedulingClass=idle

# The official CLIs some sources run (codex, opencode) live here; pnpm puts
# global CLIs in $PNPM_HOME or, in recent versions, $PNPM_HOME/bin. A
# drop-in can extend PATH.
Environment=PATH=%h/.local/bin:%h/.local/share/pnpm:%h/.local/share/pnpm/bin:/usr/local/bin:/usr/bin:/bin

# Ataecina's own state ($XDG_STATE_HOME/ataecina) and snapshot
# ($XDG_RUNTIME_DIR/ataecina, kept between runs), created 0700.
StateDirectory=ataecina
StateDirectoryMode=0700
RuntimeDirectory=ataecina
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes

# Hardening. Home is read-only except what the official CLIs write while
# answering (Codex and OpenCode keep their own state). The mount and
# hostname options need unprivileged user namespaces: where they are
# forbidden (Ubuntu's AppArmor policy) systemd skips them, while
# NoNewPrivileges and the seccomp filters apply everywhere (ADR 0005).
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-%h/.codex -%h/.local/share/opencode -%h/.local/state/opencode -%h/.cache/opencode
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Not set: CapabilityBoundingSet=, PrivateDevices=, ProtectKernelModules=,
# ProtectKernelLogs= and ProtectClock= drop capabilities, which a user
# manager can do only inside a user namespace; without one the unit stops
# with 218/CAPABILITIES. The collector holds no capability, NoNewPrivileges
# keeps it so, and @system-service already denies the clock, module, raw
# I/O and kernel log system calls (ADR 0005).
# MemoryDenyWriteExecute= is not set: opencode runs on a JIT (ADR 0005).

# The systemd-creds unlocker adds LoadCredentialEncrypted= in a drop-in:
# ~/.config/systemd/user/ataecina-collect.service.d/master-key.conf
