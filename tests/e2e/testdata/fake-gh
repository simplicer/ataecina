#!/bin/sh
# Fake `gh` for integration, acceptance and end-to-end tests: records its
# arguments in $FAKE_GH_JOURNAL and, for `api`, prints the synthetic report
# in $FAKE_GH_REPORT. The real gh, and GitHub, are never reached.
printf '%s\n' "$*" >>"${FAKE_GH_JOURNAL:-/dev/null}"
[ "$1" = "api" ] || exit 2
[ -n "${FAKE_GH_FAIL:-}" ] && exit 1
cat "$FAKE_GH_REPORT"
