#!/bin/sh
# Fake `opencode` for integration, acceptance and end-to-end tests: records
# its arguments in $FAKE_OPENCODE_JOURNAL; for `stats` it prints the
# synthetic statistics in $FAKE_OPENCODE_STATS, for `api` the synthetic
# usage limits in $FAKE_OPENCODE_LIMITS. The real OpenCode is never started.
printf '%s\n' "$*" >>"${FAKE_OPENCODE_JOURNAL:-/dev/null}"
[ -n "${FAKE_OPENCODE_FAIL:-}" ] && exit 1
case "$1" in
stats) cat "$FAKE_OPENCODE_STATS" ;;
api) cat "$FAKE_OPENCODE_LIMITS" ;;
*) exit 2 ;;
esac
